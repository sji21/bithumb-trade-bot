# .env.example — 템플릿입니다. 실제 키는 절대 이 파일에 붙여넣지 마세요.
# 사용법: cp .env.example .env 후 값을 채우세요. .env 는 .gitignore 로 제외됩니다.

# ── 자격증명 ────────────────────────────────────────────────────────────────
BITHUMB_API_KEY=your_bithumb_access_key
BITHUMB_API_SECRET=your_bithumb_secret_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── 실행 모드 ───────────────────────────────────────────────────────────────
# false 면 주문을 만들지 않습니다(알림 전용).
ENABLE_LIVE_TRADING=false
# true 면 라이브 경로를 그대로 밟되 실주문 대신 mock 영수증만 남깁니다.
ENABLE_LIVE_SIMULATION=false

# ── 캔들 · 폴링 ─────────────────────────────────────────────────────────────
TIMEFRAME=4h
TIMEFRAME_HOURS=4
CANDLE_LIMIT=100
POLL_INTERVAL_SEC=60

# ── 지표 ────────────────────────────────────────────────────────────────────
EMA_FAST=5
EMA_SLOW=13
RSI_PERIOD=14
ATR_PERIOD=14

# ── 주문 규칙 ───────────────────────────────────────────────────────────────
FEE_RATE=0.0025          # 빗썸 시장가 수수료 0.25%
USABLE_RATIO=0.995       # 전량 주문 시 남기는 여유분
MIN_ORDER_KRW=5000       # 빗썸 최소 주문 금액
HOLD_THRESHOLD_KRW=10000 # 이 금액 이상 보유 중이면 매수에 현금 전액 투입

# ── 알림 ────────────────────────────────────────────────────────────────────
AUTH_ALERT_INTERVAL_SEC=3600  # 같은 사유 인증 실패 재알림 간격
SEND_ON_CANDLE_CLOSE=true     # 신호 없는 캔들에도 차트 전송

# 보안 권고:
# - 출금(Withdraw) 권한은 반드시 OFF
# - IP 화이트리스트 필수 (빗썸 API 2.0 은 미등록 IP 를 403 NotAllowIP 로 거부)
# - 이 파일을 저장소에 커밋하지 마세요
